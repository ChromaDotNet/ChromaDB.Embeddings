<Project>
	<PropertyGroup>
		<VersionPrefix>1.0.0</VersionPrefix>
		<VersionSuffix>preview.1</VersionSuffix>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Authors>ChromaDotNet contributors</Authors>
		<PackageTags>chroma chromadb embeddings onnx all-MiniLM-L6-v2 sentence-transformers microsoft-extensions-ai local ai rag</PackageTags>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/ChromaDotNet/ChromaDB.Embeddings</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ChromaDotNet/ChromaDB.Embeddings</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<ArtifactsPackages>$(MSBuildThisFileDirectory)artifacts\packages</ArtifactsPackages>
		<PackageOutputPath>$(ArtifactsPackages)</PackageOutputPath>
		<!-- A package cache of its own, in the repository, not in the profile of the user. -->
		<RestorePackagesPath>$(MSBuildThisFileDirectory)artifacts\nuget-cache</RestorePackagesPath>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
