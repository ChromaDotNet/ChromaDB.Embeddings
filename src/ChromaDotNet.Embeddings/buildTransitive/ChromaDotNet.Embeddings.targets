<Project>
	<!-- ChromaDotNet.Embeddings on .NET 8 and later: an application built for a 32-bit platform or runtime identifier would build and then
	     fail to load the native libraries, as ONNX Runtime has no 32-bit library from version 1.23. An AnyCPU application started by a
	     32-bit runtime is stopped by CreateAsync instead, with a PlatformNotSupportedException. -->
	<Target Name="ChromaDotNetEmbeddings64BitProcess" BeforeTargets="Build" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')">
		<Error Condition="'$(PlatformTarget)' == 'x86' Or '$(PlatformTarget)' == 'arm' Or $(RuntimeIdentifier.EndsWith('-x86')) Or $(RuntimeIdentifier.EndsWith('-arm'))"
			   Text="ChromaDotNet.Embeddings needs a 64-bit process: ONNX Runtime has no 32-bit library from version 1.23. Set PlatformTarget to x64, ARM64 or AnyCPU, and a 64-bit RuntimeIdentifier." />
	</Target>
	<!-- ChromaDotNet.Embeddings on .NET Framework. .NET Framework does not load native libraries from runtimes/<rid>/native. This copies
	     the native library of the tokenizer next to the application, for x64, AnyCPU without Prefer32Bit, and ARM64; ElBruno.LocalEmbeddings
	     copies the ones of ONNX Runtime. Tokenizers.DotNet and ONNX Runtime 1.28 have no win-x86 library: a 32-bit application cannot run
	     the model. The version is the one this package depends on. All in a target, so that PlatformTarget and Prefer32Bit have their
	     final values. -->
	<Target Name="ChromaDotNetEmbeddingsNativeLibraries" AfterTargets="ResolveAssemblyReferences" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
		<PropertyGroup>
			<_ChromaEmbeddingsPlatform>$(PlatformTarget)</_ChromaEmbeddingsPlatform>
			<_ChromaEmbeddingsPlatform Condition="'$(_ChromaEmbeddingsPlatform)' == ''">$(Platform)</_ChromaEmbeddingsPlatform>
			<_ChromaEmbeddingsRid Condition="'$(_ChromaEmbeddingsPlatform)' == 'x64' Or (('$(_ChromaEmbeddingsPlatform)' == 'AnyCPU' Or '$(_ChromaEmbeddingsPlatform)' == 'Any CPU' Or '$(_ChromaEmbeddingsPlatform)' == '') And '$(Prefer32Bit)' != 'true')">win-x64</_ChromaEmbeddingsRid>
			<_ChromaEmbeddingsRid Condition="'$(_ChromaEmbeddingsPlatform)' == 'ARM64'">win-arm64</_ChromaEmbeddingsRid>
			<!-- The global packages folder of PackageReference (lowercase id/version), or the packages folder of packages.config (Id.Version). -->
			<_ChromaEmbeddingsTokenizer Condition="'$(NuGetPackageRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))tokenizers.dotnet.runtime.$(_ChromaEmbeddingsRid)\1.4.1\runtimes\$(_ChromaEmbeddingsRid)\native\hf_tokenizers.dll</_ChromaEmbeddingsTokenizer>
			<_ChromaEmbeddingsTokenizer Condition="'$(NuGetPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Tokenizers.DotNet.runtime.$(_ChromaEmbeddingsRid).1.4.1\runtimes\$(_ChromaEmbeddingsRid)\native\hf_tokenizers.dll</_ChromaEmbeddingsTokenizer>
		</PropertyGroup>
		<Error Condition="'$(_ChromaEmbeddingsRid)' == '' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')"
			   Text="ChromaDotNet.Embeddings on .NET Framework needs a 64-bit process: ONNX Runtime 1.28 has no win-x86 library. Set PlatformTarget to x64 or ARM64, or AnyCPU with Prefer32Bit false." />
		<Warning Condition="'$(_ChromaEmbeddingsRid)' != '' And !Exists('$(_ChromaEmbeddingsTokenizer)')"
				 Text="ChromaDotNet.Embeddings did not find hf_tokenizers.dll of $(_ChromaEmbeddingsRid) in the packages folder: copy it next to the application." />
		<ItemGroup Condition="'$(_ChromaEmbeddingsRid)' != '' And Exists('$(_ChromaEmbeddingsTokenizer)')">
			<ReferenceCopyLocalPaths Include="$(_ChromaEmbeddingsTokenizer)" DestinationSubDirectory="" />
		</ItemGroup>
	</Target>
</Project>
