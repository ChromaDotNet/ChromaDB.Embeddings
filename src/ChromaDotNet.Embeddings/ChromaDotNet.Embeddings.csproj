<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- net462: .NET Framework on Windows, as the net462 build of ChromaDotNet.Client. -->
		<TargetFrameworks>net8.0;net462</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<PackageId>ChromaDotNet.Embeddings</PackageId>
		<RootNamespace>ChromaDotNet.Embeddings</RootNamespace>
		<PackageDescription>The embedding functions of Chroma for .NET, computed locally. The default one: all-MiniLM-L6-v2 in ONNX, with the same vectors as the Python client. The hosted ones of Chroma Cloud: chroma-cloud-qwen (Qwen3-Embedding-0.6B) and chroma-cloud-splade (SPLADE), without an account or an API key. IEmbeddingGenerator of Microsoft.Extensions.AI, for ChromaDotNet.Client 2.17.0 and later. The models are downloaded at the first start and checked with their SHA-256: the default one into the cache folder of Python, the hosted ones from Hugging Face. On .NET 8 and later the default model runs through ElBruno.LocalEmbeddings by Bruno Capuano; on .NET Framework (Windows, 64-bit), and for the hosted models, on ONNX Runtime. Tokenizer: Hugging Face, through Tokenizers.DotNet. Intel Macs and 32-bit processes are not supported. Independent project. Not affiliated with, endorsed by or sponsored by Chroma Inc. CHROMA is a registered trademark of Chroma Inc., used here only to describe compatibility.</PackageDescription>
		<PackageReleaseNotes>1.0.0-preview.6: ChromaQwenEmbeddingGenerator refuses a text of more than 8192 tokens, MaxTokens, with an ArgumentException, before any text of the call is computed. It truncated a text at 32768 tokens: beyond 8192 the attention mask of the ONNX export needs more than 4 GiB, and in our tests a text of 16384 tokens used all the memory of a machine of 32 GB. The package runs on ONNX Runtime 1.28.0, not 1.24.4, on both targets, and on .NET 8 the default model too. In our tests the vectors of Qwen are those of 1.24.4, and those of SPLADE differ by up to 1.2e-4. From version 1.29 on, ONNX Runtime computes Qwen in float16 otherwise on Linux arm64, further from the vectors of Chroma Cloud. All the releases: $(PackageProjectUrl)/releases.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TokenizersVersion>1.4.1</TokenizersVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="ChromaDotNet.Embeddings.Tests" />
	</ItemGroup>
	<ItemGroup>
		<!-- The public API, checked at build: the same files for both targets. -->
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
		<!-- The version ElBruno.LocalEmbeddings already resolves: referenced here for the LoggerMessage generator. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
		<!-- The hosted models run on ONNX Runtime directly, on both targets. ElBruno.LocalEmbeddings asks for 1.24.4 or later: on .NET 8
		     the default model runs on this version too. -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
		<!-- The tokenizer of Python: the Rust library tokenizers of Hugging Face, with its native library for each platform. -->
		<PackageReference Include="Tokenizers.DotNet" Version="$(TokenizersVersion)" />
		<PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="$(TokenizersVersion)" />
		<PackageReference Include="Tokenizers.DotNet.runtime.win-arm64" Version="$(TokenizersVersion)" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<!-- The ONNX model: mean pooling with the attention mask and L2 normalization. It brings Microsoft.Extensions.AI.Abstractions
		     10.4.1, and ONNX Runtime 1.24.4, which the reference above raises to 1.28.0. -->
		<PackageReference Include="ElBruno.LocalEmbeddings" Version="1.6.6" />
		<PackageReference Include="Tokenizers.DotNet.runtime.linux-x64" Version="$(TokenizersVersion)" />
		<PackageReference Include="Tokenizers.DotNet.runtime.linux-arm64" Version="$(TokenizersVersion)" />
		<!-- Kept for the tokenizer, though ONNX Runtime 1.28 has no osx-x64 library: Intel Macs are not supported. -->
		<PackageReference Include="Tokenizers.DotNet.runtime.osx-x64" Version="$(TokenizersVersion)" />
		<PackageReference Include="Tokenizers.DotNet.runtime.osx-arm64" Version="$(TokenizersVersion)" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
		<!-- ElBruno.LocalEmbeddings is for .NET 8 and later: here the versions it brings, and the pooling of OnnxEmbeddingModel.cs. -->
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.4.1" />
		<!-- System.Formats.Tar is for .NET 7 and later. -->
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.Net.Http" />
	</ItemGroup>
	<ItemGroup>
		<!-- .NET Framework does not read runtimes/: this copies the native libraries of the tokenizer and of ONNX Runtime next to the
		     application: buildTransitive for PackageReference, build for packages.config. -->
		<None Include="buildTransitive\ChromaDotNet.Embeddings.targets" Pack="true" PackagePath="buildTransitive\net462\;build\net462\;buildTransitive\net8.0\" />
	</ItemGroup>
</Project>
